<?xml version="1.0" encoding="utf-8"?>
<!-- Root: full-screen dark background for the round 432x432 Wear OS display -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d0d1a">
    
    <TextView
        android:layout_width="0dp"
        android:layout_height="0dp"/>

    <!-- ── CONNECTION UI ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutConnect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="#0d0d1a">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Miu Robot IP"
            android:textColor="#a855f7"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etIpAddress"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/arrow_inactive"
            android:textColor="#ffffff"
            android:textColorHint="#4a3a6a"
            android:textSize="16sp"
            android:gravity="center"
            android:hint="192.168.4.1"
            android:inputType="textUri"
            android:imeOptions="actionDone"
            android:maxLines="1"/>

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Bağlan"
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:backgroundTint="#7c3aed"
            android:paddingHorizontal="24dp"/>
            
         <TextView
            android:id="@+id/tvConnectError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#ff5555"
            android:textSize="12sp"
            android:gravity="center"/>

    </LinearLayout>

    <!-- ── TILT UI ───────────────────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/layoutTilt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- ── FORWARD (↑) ─────────────────────────────────────────────────── -->
        <TextView
        android:id="@+id/arrowUp"
        android:layout_width="48dp"
        android:layout_height="24dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="↑"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/arrow_inactive"/>

    <!-- ── BACKWARD (↓) ─────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/arrowDown"
        android:layout_width="48dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="↓"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/arrow_inactive"/>

    <!-- ── LEFT (←) ──────────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/arrowLeft"
        android:layout_width="24dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:text="←"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/arrow_inactive"/>

    <!-- ── RIGHT (→) ─────────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/arrowRight"
        android:layout_width="24dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:text="→"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/arrow_inactive"/>

    <!-- ── CENTER: direction label + sensor readout ──────────────────────── -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <!-- BT Status -->
        <TextView
            android:id="@+id/tvBtStatusWatch"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center"
            android:layout_marginBottom="2dp"
            android:background="@drawable/arrow_inactive"
            android:backgroundTint="#f87171"
            android:elevation="10dp"/>

        <!-- Miu Logo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🐾 Miu"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#c084fc"
            android:shadowColor="#66a855f7"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="16"
            android:letterSpacing="-0.02"
            android:gravity="center"/>

        <!-- Live beta / gamma values -->
        <TextView
            android:id="@+id/tvSensor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="3dp"
            android:text="β 0°  γ 0°"
            android:textSize="9sp"
            android:textColor="#4a3a6a"
            android:fontFamily="monospace"
            android:gravity="center"/>

        <!-- Toggles -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center">
            
            <TextView
                android:id="@+id/btnGyroToggle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/arrow_active"
                android:text="🧭"
                android:gravity="center"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/btnAvatarToggle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/arrow_inactive"
                android:text="👽"
                android:gravity="center"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/btnPushupToggle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/arrow_inactive"
                android:text="💪"
                android:gravity="center"
                android:textSize="14sp"/>
        </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</FrameLayout>
